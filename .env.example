# =============================================================================
# Scoil Bhríde Online Payment Portal — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# The public URL of this application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment: development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER-SIDE ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Encryption (required) — encrypts sensitive fields (e.g. provider credentials,
# PPSN) via lib/crypto. Any non-empty string; it is hashed to a 32-byte key, so a
# base64/hex 32-byte value or a long passphrase both work. KEEP IT STABLE —
# changing it makes existing ciphertext undecryptable. Generate: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here

# -----------------------------------------------------------------------------
# Stripe (use test keys for development and staging)
# -----------------------------------------------------------------------------
# Found in: Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Webhook signing secret — found in: Stripe Dashboard → Developers → Webhooks
# For local testing: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Signing secret for the SEPARATE "Connected accounts" webhook endpoint (Stripe
# Connect). Direct-charge parent payments and account.updated events arrive here.
# Create a second endpoint at the SAME URL with "Events from → Connected accounts"
# and paste its secret. Optional until Connect is live.
# Local: stripe listen --forward-connect-to localhost:3000/api/webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-webhook-secret

# Subscription (SaaS billing) price IDs — created in Stripe Dashboard → Products.
# Create a "Pro" product with a monthly and an annual recurring price, then paste
# the price IDs here. Used by the subscription checkout flow (Phase 2). Optional
# until subscriptions are enabled.
STRIPE_PRO_MONTHLY_PRICE_ID=price_your-pro-monthly-price-id
STRIPE_PRO_ANNUAL_PRICE_ID=price_your-pro-annual-price-id
# €44.99 "Pro + SMS" tier price IDs. A subscription on one of these grants the SMS
# entitlement (subscriptions.sms_enabled) at webhook-sync time. Optional until the
# live Pro+SMS product exists — SMS stays gated off until then.
STRIPE_PRO_SMS_MONTHLY_PRICE_ID=price_your-pro-sms-monthly-price-id
STRIPE_PRO_SMS_ANNUAL_PRICE_ID=price_your-pro-sms-annual-price-id

# -----------------------------------------------------------------------------
# Platform owner (all-schools overview at /platform)
# -----------------------------------------------------------------------------
# Comma-separated email(s) that may see the platform-owner "Schools" view.
# super_admin is a PER-SCHOOL role, so it can't gate an all-schools view — this
# is matched against the signed-in user's email. Leave blank to disable /platform.
PLATFORM_OWNER_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Twilio (parent SMS) — optional; SMS sending is inert until all three are set
# -----------------------------------------------------------------------------
# Found in: Twilio Console. Sender ID must be ComReg-registered for Ireland.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid
# Delivery-status webhook (Phase 4). Set to https://<host>/api/webhooks/sms/status
# and register it as the Messaging Service status callback.
TWILIO_STATUS_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Resend (transactional email)
# -----------------------------------------------------------------------------
# Found in: Resend Dashboard → API Keys
RESEND_API_KEY=re_your-resend-api-key

# The "From" address for all outgoing emails (must be verified in Resend)
# Example: payments@scoilbhride.ie
EMAIL_FROM_ADDRESS=noreply@yourdomain.ie
EMAIL_FROM_NAME=Scoil Bhríde Payment Portal

# The school's general inbox — receives payment notification emails
SCHOOL_NOTIFICATION_EMAIL=office@yourdomain.ie

# -----------------------------------------------------------------------------
# Cron / scheduled jobs (optional)
# -----------------------------------------------------------------------------
# A secret token to authenticate internal cron endpoints
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# -----------------------------------------------------------------------------
# School configuration (single-school POC)
# -----------------------------------------------------------------------------
# The UUID of the school record in the database (from seed.sql / schools table)
NEXT_PUBLIC_SCHOOL_ID=00000000-0000-0000-0000-000000000001

# -----------------------------------------------------------------------------
# Application environment (§17.3)
# -----------------------------------------------------------------------------
# poc | production — controls POC warning banner and test-data guardrails
APP_ENV=poc

# -----------------------------------------------------------------------------
# Production-only settings (leave blank in development)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://payments.scoilbhride.ie
