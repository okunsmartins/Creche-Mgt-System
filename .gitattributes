# Normalise line endings: store text files as LF in git and check them out as
# LF on every platform. This keeps Prettier (endOfLine: lf) and CI's
# `format:check` consistent with the working tree on Windows, where
# core.autocrlf=true would otherwise produce CRLF working-tree files that
# locally false-fail format:check.
* text=auto eol=lf

# Common binary types — never apply EOL conversion (text=auto usually detects
# these, but being explicit avoids any chance of corruption).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.pdf   binary
